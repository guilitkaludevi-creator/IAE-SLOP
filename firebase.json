{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "context doc.md",
      "WhatsApp Video 2026-11-21 at 21.45.35.mp4",
      "WhatsApp Image 2026-11-22 at 01.25.43.jpeg",
      "WhatsApp Video 2026-11-22 at 01.25.43.mp4",
      "WhatsApp Video 2026-11-22 at 01.25.43 (1).mp4",
      "WhatsApp Video 2026-11-22 at 01.25.43 (2).mp4",
      "**/.*",
      ".git/**",
      "**/.git/**",
      ".firebase/**",
      "**/.firebase/**",
      "functions/**",
      "**/node_modules/**",
      "flutter_app/**",
      "screenshots/**"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=86400"
          }
        ]
      },
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
